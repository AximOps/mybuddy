# Neon connection string (Singapore project). Use the pooled connection and keep sslmode=require.
DATABASE_URL=postgresql://mybuddy_app:CHANGE_ME@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/mybuddy?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-a-long-random-string-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (OAuth client for web). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple sign-in. APPLE_CLIENT_ID is the Services ID; APPLE_CLIENT_SECRET is a signed JWT made from your Apple key.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Owner connection string, used ONLY by `npm run db:migrate`. Never used by the web app.
MIGRATION_DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional: addresses of the Amiroon app's browser build that may call the API (comma separated).
# Native phone apps do not need this.
MOBILE_WEB_ORIGINS=
